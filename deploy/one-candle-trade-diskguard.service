[Unit]
Description=Daily disk guard for One Candle Trade host

[Service]
Type=oneshot
ExecStart=/var/projects/one-candle-trade/deploy/disk-guard.sh
# Output goes to the journal (which is itself capped by journald-size-cap.conf),
# not to the bot's log file, so the guard can never inflate what it is guarding.
StandardOutput=journal
StandardError=journal
